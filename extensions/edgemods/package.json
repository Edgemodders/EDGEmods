{
  "name": "edgemods",
  "displayName": "EDGEmods",
  "description": "The EDGE mod registry for Cyberpunk 2077 in VS Code: sign in, find mods and install them with what they need, through EDGEdeck.",
  "version": "0.1.0",
  "publisher": "edgemodders",
  "preview": true,
  "private": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEmods"
  },
  "homepage": "https://edgemods.ai",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEmods/issues"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "modding",
    "mods",
    "edgedeck",
    "redcode"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onAuthenticationRequest:edgemods"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "edgemods",
        "label": "EDGEmods"
      }
    ],
    "commands": [
      {
        "command": "edgemods.signIn",
        "title": "Sign in",
        "category": "EDGEmods",
        "icon": "$(sign-in)"
      },
      {
        "command": "edgemods.signOut",
        "title": "Sign out",
        "category": "EDGEmods",
        "icon": "$(sign-out)"
      },
      {
        "command": "edgemods.chooseUsername",
        "title": "Choose your username",
        "category": "EDGEmods"
      },
      {
        "command": "edgemods.account",
        "title": "Account",
        "category": "EDGEmods",
        "icon": "$(account)"
      }
    ],
    "configuration": {
      "title": "EDGEmods",
      "properties": {
        "edgemods.site": {
          "type": "string",
          "default": "https://edgemods.ai",
          "scope": "application",
          "markdownDescription": "The EDGEmods site to use. Leave it at `https://edgemods.ai`. A developer running the website on this PC sets `http://localhost:8800`. Only https addresses, or http on this PC, are used. Set for the whole editor only, so a folder you open cannot change it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && node --test \"test/*.test.mjs\"",
    "package": "vsce package --no-dependencies --out dist/"
  },
  "dependencies": {
    "@edgemodders/edgemods-format": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  }
}
