# EDGEmods' settings on the server: /etc/edgemods.env, root:edgemods 0640. deploy/setup-edgemods.sh copies this
# file there the first time and never overwrites it after. Every setting is read by packages/server/src/config.ts;
# the service prints at start what is missing (journalctl -u edgemods -n 20).
#
# Secrets: fill them on the server only. Never paste them in a chat, an issue or a commit. Make a random one with
#   openssl rand -base64 48

# ---- the site ----
EDGEMODS_PUBLIC_URL=https://edgemods.ai
# 127.0.0.1 behind nginx. 8800: TheLostRealms uses 8787 and 8790 to 8794 on the same server.
EDGEMODS_HOST=127.0.0.1
EDGEMODS_PORT=8800

# ---- accounts: the production Auth0 tenant (docs/auth0-setup.md) ----
# The sign-in page's address: the custom domain, login.edgemods.ai, once Auth0 has verified it.
EDGEMODS_AUTH0_DOMAIN=
# The tenant's own domain (edgemods.us.auth0.com or as Auth0 named it), for the Management API, which never uses
# the custom domain. Leave empty only if the line above is the tenant's own domain too.
EDGEMODS_AUTH0_MANAGEMENT_DOMAIN=
EDGEMODS_AUTH0_CLIENT_ID=
EDGEMODS_AUTH0_CLIENT_SECRET=
# The EDGEmods API's identifier, and the VS Code extension's Native application (step 9).
EDGEMODS_AUTH0_AUDIENCE=
EDGEMODS_AUTH0_EXTENSION_CLIENT_ID=
# The in-game browser's Native application, with the Device Code grant (step 10).
EDGEMODS_AUTH0_REDNODE_CLIENT_ID=
# Deleting accounts (the Management API application).
EDGEMODS_AUTH0_MANAGEMENT_CLIENT_ID=
EDGEMODS_AUTH0_MANAGEMENT_CLIENT_SECRET=
# Signs the sign-in's short cookie. 32 characters or more, random.
EDGEMODS_SESSION_SECRET=
# Admins' email addresses, comma separated. An address counts once Auth0 has verified it.
EDGEMODS_ADMINS=

# ---- downloads (docs/design.md, "Subscriptions and download speed") ----
# nginx: files stream from GitHub through nginx at the free speed (deploy/nginx/edgemods-downloads.conf).
EDGEMODS_DOWNLOADS=nginx
# MB a second, the owner's to set.
EDGEMODS_FREE_SPEED=3
# A GitHub token with no scopes (a fine-grained one with public read only): 5,000 GitHub reads an hour instead of 60
# when finding a file's address. Optional, but a busy day needs it.
EDGEMODS_GITHUB_TOKEN=

# ---- EDGEmods' own workflows ----
# Signs the merge checks' and release checks' results and the blocklist question (POST /api/v1/checks,
# /api/v1/blocklist/check). The same value goes in the EDGEmods repository's secret EDGEMODS_CHECKS_SECRET.
EDGEMODS_CHECKS_SECRET=
# Signs a new index.db from the index rebuild (POST /api/v1/admin/index). The same value goes in the repository's
# secret EDGEMODS_INDEX_SECRET. A different value from the one above.
EDGEMODS_INDEX_SECRET=
