{
  "name": "edgemods-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/format",
    "packages/checks"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace packages/format && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:example": "node packages/format/bin/edgemods-check.mjs examples/example-mod"
  },
  "engines": {
    "node": ">=22.13"
  }
}
