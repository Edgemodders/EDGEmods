{
  "name": "@edgemodders/edgemods-format",
  "version": "0.1.0",
  "private": true,
  "description": "The edgemods.json metadata format: its JSON schema, a validator that explains problems in plain words, and checks for a mod's folder and release.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./folder": "./dist/folder.js",
    "./schema": "./schema/edgemods.schema.json"
  },
  "bin": {
    "edgemods-check": "bin/edgemods-check.mjs"
  },
  "files": [
    "dist",
    "schema",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "npm run build && node bin/write-schema.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
